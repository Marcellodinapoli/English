  "title": "to be — am / is / are",
  "titleIt": "Il verbo to be",
  "examples": ["I am tired.", "She is hungry.", "They are ready."],
  "pattern": "I + am · he/she/it + is · you/we/they + are",
  "explanation": "Use am with I. Use is with he, she, it. Use are with you, we, they.",
  "explanationIt": "Usa am con I. Usa is con he/she/it. Usa are con you/we/they.",
  "realUse": [
    "I am from Italy.",
    "He is my brother.",
    "Are you ready?"
  ],
