  "exercises": [
    {
      "id": "ex1",
      "type": "multiple_choice",
      "prompt": "Choose the correct advice sentence.",
      "promptIt": "Scegli la frase di consiglio corretta.",
      "options": [
        "You should book early.",
        "You should to book early.",
        "You should booking early.",
        "You shoulds book early."
      ],
      "answer": "You should book early.",
      "explanation": "After should, use the base form of the verb (book)."
    },
    {
      "id": "ex2",
      "type": "fill_blank",
      "prompt": "Can I give you some ____?",
      "promptIt": "Completa: Can I give you some ____?",
      "answer": "advice",
      "explanation": "Advice is uncountable: some advice (not an advice)."
    },
    {
      "id": "ex3",
      "type": "multiple_choice",
      "prompt": "Which phrase softens advice?",
      "promptIt": "Quale frase rende il consiglio più delicato?",
      "options": [
        "If I were you, I would call them.",
        "You must call them now!",
        "Call them immediately.",
        "Do it."
      ],
      "answer": "If I were you, I would call them.",
      "explanation": "If I were you is a polite way to give personal advice."
    }
  ],
