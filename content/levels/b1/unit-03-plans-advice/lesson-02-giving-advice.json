  "introduction": {
    "headline": "Advise someone politely",
    "body": "Learn how to suggest solutions with should, why don't you, and If I were you.",
    "bodyIt": "Impara a suggerire soluzioni con should, why don't you e If I were you.",
    "objectives": [
      "Use should / shouldn't for advice",
