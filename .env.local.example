DATABASE_URL="file:./dev.db"
AUTH_SECRET="change-me-to-a-long-random-string"

# AI is prepared in the codebase but OFF by default.
# The full didactic experience runs on Alinea (content + RuleBased + ReviewQueue
# + DailyPlan + LessonEngine + LevelProgression + heuristics).
# To activate OpenAI later: set AI_ENABLED=true AND OPENAI_API_KEY.
AI_ENABLED=false
OPENAI_API_KEY=""
AI_PROVIDER="openai"
AI_CHAT_MODEL="gpt-4o-mini"
# Per-function overrides (optional): AI_MODEL_CONTEXTUAL_MEANING, AI_MAX_TOKENS_AI_EXERCISE, etc.
AI_RETRY_BACKOFF_MS="800"
AI_TTS_MODEL="tts-1"
AI_STT_MODEL="whisper-1"

NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
# Production domain required for App Store / Play Store builds
NEXT_PUBLIC_APP_URL="https://your-production-domain.com"
CAPACITOR_SERVER_URL="https://your-production-domain.com"
# Comma-separated admin emails (CMS access). Mirror in NEXT_PUBLIC_ADMIN_EMAILS for client UI.
ADMIN_EMAILS="admin@example.com"
NEXT_PUBLIC_ADMIN_EMAILS="admin@example.com"
